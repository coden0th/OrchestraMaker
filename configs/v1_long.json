{
  "data": "data/tokens_v1",
  "init_from": "checkpoints/v1_piano/best.pt",
  "model": {"block_size": 8192, "n_layer": 12, "n_head": 12, "n_embd": 768, "dropout": 0.05},
  "source_weights": {"pianocore": 0.9, "pijama": 0.1},
  "max_transpose": 3,
  "batch_size": 8,
  "grad_accum": 1,
  "max_steps": 3000,
  "lr": 2e-4,
  "min_lr": 2e-5,
  "warmup_steps": 200,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "eval_every": 250,
  "eval_batches": 10,
  "compile": true,
  "out_dir": "checkpoints/v1_long",
  "seed": 1
}
